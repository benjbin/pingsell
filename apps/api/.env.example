PORT=4000
DATABASE_PATH=./missive.db
PUBLIC_URL=http://localhost:4000        # used in tracking links
WEB_URL=http://localhost:5173           # CORS origin (comma-separated list allowed)
EMAIL_PROVIDER=log                       # log | ses
AWS_REGION=eu-west-3                     # if ses
SHOPIFY_API_KEY=                         # optional, for OAuth public-app flow
SHOPIFY_API_SECRET=
# Shopify App Pricing (optional): Partner API client with "Manage apps", to read each store's plan.
# SHOPIFY_PARTNER_ORG_ID=                 # number in partners.shopify.com/<org id>/...
# SHOPIFY_PARTNER_API_TOKEN=
# SHOPIFY_APP_ID=                         # number in the app's Partner Dashboard URL
# SHOPIFY_APP_HANDLE=pingsell             # `handle` of shopify.app.toml

# --- Optional tuning (defaults shown) ---
# MAIL_FROM_EMAIL=bonjour@pingsell.local  # default sender address (must be verified in SES)
# WORKER_INTERVAL_MS=2000                # background worker tick
# SEND_BATCH_SIZE=50                     # messages sent per tick
# SEND_RATE_PER_SECOND=14                # provider rate limit
# HOST=0.0.0.0

# Push notifications to the merchant's own app (FCM / APNs / Expo). Credentials are set per account in the app.
PUSH_MODE=live                           # live (default: real Apple / Google / Expo delivery) | log (nothing leaves the machine)
# PUSH_FCM_URL=https://fcm.googleapis.com
# PUSH_APNS_URL=https://api.push.apple.com
# PUSH_APNS_SANDBOX_URL=https://api.sandbox.push.apple.com
# PUSH_EXPO_URL=https://exp.host/--/api/v2/push/send

# Sauvegardes chiffrées quotidiennes (docs/securite/sauvegardes.md). Sans clé : aucune sauvegarde.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_KEEP=14
# BACKUP_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# BACKUP_S3_REGION=gra
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
